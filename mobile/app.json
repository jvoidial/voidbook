{
  "expo": {
    "name": "VOIDBOOK",
    "slug": "voidbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.voidial.voidbook",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "VOIDBOOK uses your photos for profile pictures and posts.",
          "cameraPermission": "VOIDBOOK uses your camera to take photos and record videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VOIDBOOK uses your camera for photos, videos, and live streams.",
          "microphonePermission": "VOIDBOOK uses your microphone for video and live streams.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}