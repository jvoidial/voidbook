{
  "expo": {
    "name": "sqawk",
    "slug": "sqawk",
    "scheme": "sqawk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.voidial.voidbook",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#000000"
      },
      "newArchEnabled": false
    },
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "icon": "./assets/icon.jpg",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "sqawk uses photos.",
          "cameraPermission": "sqawk uses camera."
        }
      ]
    ],
    "newArchEnabled": false,
    "ios": {
      "newArchEnabled": false
    }
  }
}