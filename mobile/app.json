{
  "expo": {
    "name": "SQWAK.app",
    "slug": "sqawk",
    "scheme": "sqawk",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.voidial.voidbook",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "newArchEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.voidial.voidbook",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SQWAK.app uses the camera for photos and live video.",
        "NSMicrophoneUsageDescription": "SQWAK.app uses the microphone for audio spaces and live video.",
        "NSPhotoLibraryUsageDescription": "SQWAK.app lets you choose a photo to post."
      },
      "newArchEnabled": false
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "SQWAK.app uses photos.",
          "cameraPermission": "SQWAK.app uses the camera."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SQWAK.app uses the camera for photos and live video.",
          "microphonePermission": "SQWAK.app uses the microphone for audio spaces and live video.",
          "recordAudioAndroid": true
        }
      ],
      "@daily-co/config-plugin-rn-daily-js"
    ],
    "newArchEnabled": false
  }
}
